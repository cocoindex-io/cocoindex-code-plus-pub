{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(rg *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git grep *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git log *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git -C *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(sed *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(head *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(cat *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(awk *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(tail *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-brief-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(rg *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git grep *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-claude-hook.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ccx-brief-hook.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
